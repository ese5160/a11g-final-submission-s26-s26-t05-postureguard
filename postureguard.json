    {
        "id": "147341ab4c91606e",
        "type": "function",
        "z": "e37831a30ccb8ff4",
        "name": "function 3",
        "func": "let d = msg.payload;\n\n// In case payload is string\nif (typeof d === \"string\") {\n    d = JSON.parse(d);\n}\n\n// Safe pressure array\nlet p = d.pressure_mv || [];\n\nmsg.payload = {\n    timestamp: new Date().toISOString(),\n    ts: d.ts,\n\n    ax: d.ax,\n    ay: d.ay,\n    az: d.az,\n\n    gx: d.gx,\n    gy: d.gy,\n    gz: d.gz,\n\n    pressure1_mv: p[0] ?? \"\",\n    pressure2_mv: p[1] ?? \"\",\n    pressure3_mv: p[2] ?? \"\",\n    pressure4_mv: p[3] ?? \"\",\n    pressure5_mv: p[4] ?? \"\",\n    pressure6_mv: p[5] ?? \"\",\n    pressure7_mv: p[6] ?? \"\",\n    pressure8_mv: p[7] ?? \"\",\n    pressure9_mv: p[8] ?? \"\",\n    pressure10_mv: p[9] ?? \"\",\n\n    flex_mv: d.flex_mv ?? \"\",\n    posture: d.posture ?? \"\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 80,
        "wires": [
